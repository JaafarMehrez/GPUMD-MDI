###########################################################
# Makefile for the GPUMD MDI executable
# This creates a separate gpumd-mdi executable with MDI support
# NOTE: Run this makefile from the src/ directory
#
# Build with (from src/):
#   make -f makefile_mdi USE_MDI=1
#   make -f makefile_mdi USE_MDI=1 MDI_LIB=1 MDI_LIB_PATH=/path/to/MDI_Library/install/lib64 MDI_INC_PATH=/path/to/MDI_Library/install/include
#
# Run with:
#   ./gpumd-mdi --mdi "-role ENGINE -name gpumd -method TCP -port 8021" -in run.in
###########################################################

###########################################################
# some flags
###########################################################
CC = nvcc
CUDA_ARCH=-arch=sm_60
ifdef OS # For Windows with the cl.exe compiler
CFLAGS = -O3 $(CUDA_ARCH)
else # For linux
CFLAGS = -std=c++14 -O3 $(CUDA_ARCH)
endif

# MDI support
ifdef USE_MDI
  CFLAGS += -DUSE_MDI
  MDI_SUPPORT = 1
endif

INC = -I. -Imain_gpumd
LDFLAGS =
LIBS = -lcublas -lcusolver -lcufft

# MDI library linking
ifdef MDI_LIB
  ifdef MDI_INC_PATH
    INC += -I$(MDI_INC_PATH)
  endif
  ifdef MDI_LIB_PATH
    LDFLAGS += -L$(MDI_LIB_PATH)
    # Bake the library directory into the executable so the shared libmdi
    # is found at runtime without needing LD_LIBRARY_PATH. nvcc does not
    # accept -Wl,... directly, so forward the flags to the host linker.
    LDFLAGS += -Xlinker -rpath -Xlinker $(MDI_LIB_PATH)
  endif
  LIBS += -lmdi
endif


###########################################################
# source files for gpumd-mdi
#
# The MDI build replaces main_gpumd/main.cu and main_gpumd/run.cu with the
# MDI-aware versions in main_mdi/. The remaining main_gpumd sources are reused.
###########################################################
SOURCES_MDI =                     \
	$(wildcard main_mdi/*.cu)     \
	$(wildcard minimize/*.cu)     \
	$(wildcard phonon/*.cu)       \
	$(wildcard integrate/*.cu)    \
	$(wildcard mc/*.cu)           \
	$(wildcard force/*.cu)        \
	$(wildcard force/*/*.cu)      \
	$(wildcard measure/*.cu)      \
	$(wildcard model/*.cu)        \
	$(wildcard utilities/*.cu)    \
	$(wildcard main_gpumd/velocity.cu) \
	$(wildcard main_gpumd/cohesive.cu) \
	$(wildcard main_gpumd/replicate.cu)

###########################################################
# object files
###########################################################
ifdef OS
OBJ_MDI = $(SOURCES_MDI:.cu=.obj)
else
OBJ_MDI = $(SOURCES_MDI:.cu=.o)
endif


###########################################################
# headers
###########################################################
HEADERS =                         \
	$(wildcard utilities/*.cuh)   \
	$(wildcard main_gpumd/*.cuh)  \
	$(wildcard main_mdi/*.cuh)    \
	$(wildcard integrate/*.cuh)   \
	$(wildcard mc/*.cuh)          \
	$(wildcard minimize/*.cuh)    \
	$(wildcard force/*.cuh)       \
	$(wildcard force/*/*.cuh)     \
	$(wildcard measure/*.cuh)     \
	$(wildcard model/*.cuh)       \
	$(wildcard phonon/*.cuh)


###########################################################
# executable
###########################################################
all: gpumd-mdi
gpumd-mdi: $(OBJ_MDI)
	$(CC) $(LDFLAGS) $^ -o gpumd-mdi $(LIBS)
	@echo =================================================
	@echo The gpumd-mdi executable is successfully compiled!
	@echo =================================================


###########################################################
# rules for building object files
###########################################################
# One static pattern rule per object-file suffix, instead of one rule per
# directory. That way sources in nested directories are handled too: GPUMD
# master keeps adding those (e.g. force/nep_charge_vdw/*.cu, compiled by its
# own makefile via $(wildcard force/*/*.cu)), and leaving them out makes the
# link step fail with undefined references.
ifdef OS
$(OBJ_MDI): %.obj: %.cu $(HEADERS)
	$(CC) $(CFLAGS) $(INC) -c $< -o $@
else
$(OBJ_MDI): %.o: %.cu $(HEADERS)
	$(CC) $(CFLAGS) $(INC) -c $< -o $@
endif


###########################################################
# clean up
###########################################################
clean:
ifdef OS
	del /s *.obj *.exp *.lib *.exe
else
	rm -f $(OBJ_MDI) gpumd-mdi
endif
